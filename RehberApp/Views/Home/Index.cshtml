@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-5 fw-bold">RehberApp</h1>
    <p class="fs-5 text-muted">
        Kişi kayıtlarını tek yerden tutun, düzenleyin ve raporlayın.
        Kişileri birimlere göre gruplayın, arayın ve filtreleyin.
    </p>
    <a asp-controller="Kisiler" asp-action="Index" class="btn btn-primary btn-lg">Rehbere Git</a>
    <a asp-controller="Kisiler" asp-action="Create" class="btn btn-outline-secondary btn-lg">Yeni Kişi Ekle</a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <div class="display-4 fw-bold">@ViewBag.KisiSayisi</div>
                <div class="text-muted">Kayıtlı Kişi</div>
                <a asp-controller="Kisiler" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <div class="display-4 fw-bold">@ViewBag.BirimSayisi</div>
                <div class="text-muted">Tanımlı Birim</div>
                <a asp-controller="Birimler" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>