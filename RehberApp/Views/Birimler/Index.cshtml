@model IEnumerable<RehberApp.Models.Birim>

@{
    ViewData["Title"] = "Birimler";
}

<h1>Birimler</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Birim Ekle</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Birim Adı</th>
            <th style="width: 200px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Ad</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu birimi silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>