@model IEnumerable<RehberApp.Models.Kisi>

@{
    ViewData["Title"] = "Rehber";
}

<h1>Rehber</h1>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <a asp-action="Create" class="btn btn-primary">Yeni Kişi Ekle</a>

    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2">
        <input type="text" name="arama" value="@ViewBag.Arama"
               class="form-control" style="width: 240px;"
               placeholder="Ad, soyad, e-posta, telefon..." />

        <select name="birimId" asp-items="ViewBag.BirimId" class="form-select" style="width: 180px;">
            <option value="">Tüm birimler</option>
        </select>

        <button type="submit" class="btn btn-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </form>
</div>

<p class="text-muted">@Model.Count() kayıt listeleniyor.</p>

<table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-primary">
        <tr>
            <th>Ad</th>
            <th>Soyad</th>
            <th>E-posta</th>
            <th>Telefon</th>
            <th>Ünvan</th>
            <th>Birim</th>
            <th style="width: 200px; white-space: nowrap;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Ad</td>
                <td>@item.Soyad</td>
                <td>@item.Eposta</td>
                <td>@item.Telefon</td>
                <td>@item.Unvan</td>
                <td>@(item.Birim?.Ad ?? "-")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu kişiyi silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>